# Backend runtime
NODE_ENV=development
PORT=3000

# Comma-separated origins allowed by CORS + Socket.IO
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# Frontend public URL (S3/CloudFront domain)
FRONTEND_BASE_URL=https://your-frontend-domain

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=scope_tour
DB_USER=root
DB_PASSWORD=your_db_password

# Queue and cache
RABBITMQ_URL=amqp://localhost
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=replace-with-strong-secret

# Email (move these to AWS Secrets Manager in production)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password
EMAIL_FROM=ScopeTour <your_email@gmail.com>
